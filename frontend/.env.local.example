# Frontend environment (EXAMPLE) — copy to .env.local and fill in.
# .env.local is gitignored. Only PUBLIC values belong here.

NEXT_PUBLIC_SUPABASE_URL=https://sdfhhqyxuubcdmqjznor.supabase.co

# Publishable / anon key (safe for the browser). NEVER put the service-role
# secret here or in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# FastAPI backend base URL. In production set this to the Render URL, e.g.
# https://ltfx-backend.onrender.com — NOT localhost.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional. Leave unset and the WebSocket URL is derived from the line above
# (http -> ws, https -> wss). Only set it if the socket lives elsewhere.
# NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000/ws/telemetry

# Default data mode when no cookie is set: "simulation" | "live"
NEXT_PUBLIC_DEFAULT_MODE=simulation
