# ---------------------------------------------------------------------------
# Fault simulator site: Chelimparambu, Chemberi, Kannur (PIN 670632).
# Adjust the lat/lng if you have a more precise pole location.
# ---------------------------------------------------------------------------
SIMULATOR_DEVICE_ID=SIM_NODE_01
SIMULATOR_PINCODE=670632
SIMULATOR_AREA=Chelimparambu, Chemberi, Kannur
SIMULATOR_LATITUDE=12.0006
SIMULATOR_LONGITUDE=75.5262
SIMULATOR_POLE_LABEL=POLE-A -> POLE-B (Chelimparambu span)

# ---------------------------------------------------------------------------
# Exotel automation. Credentials above are set, but every call/SMS is SKIPPED
# until these numbers are filled in (E.164, e.g. +919XXXXXXXXX).
# SIMULATOR_AFFECTED_USER_PHONES is comma-separated.
# NOTE: on an Exotel trial account only KYC-verified numbers can be dialled.
# ---------------------------------------------------------------------------
SIMULATOR_OPERATOR_PHONE=+916238786706
SIMULATOR_AFFECTED_USER_PHONES=
EMERGENCY_SERVICE_TYPE=police
EMERGENCY_SERVICE_NAME=
EMERGENCY_SERVICE_PHONE=

# Spoken/SMS landmark for the fault site, e.g. "the Chemberi junction".
SIMULATOR_LANDMARK=

# Second voice call to SIMULATOR_OPERATOR_PHONE reporting that the police
# station was informed. The delay lets the first call finish first.
POLICE_FOLLOWUP_CALL_ENABLED=true
POLICE_FOLLOWUP_DELAY_S=45

# Exotel's cloud must be able to reach this host to fetch voice XML and post
# callbacks. localhost will NOT work for real voice calls — set this to a public
# HTTPS URL (e.g. an ngrok/cloudflared tunnel to port 8000) before going live.
BASE_URL=http://localhost:8000
