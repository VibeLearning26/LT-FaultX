# LT-FaultX backend environment (EXAMPLE)
# Copy to .env and fill in real values. NEVER commit .env.

# Existing Supabase project
SUPABASE_URL=https://sdfhhqyxuubcdmqjznor.supabase.co

# Service-role SECRET key (starts with sb_secret_ or is the service_role JWT).
# SERVER-ONLY. Never expose to the browser / frontend / NEXT_PUBLIC / ESP32 / git.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_REAL_service_role_secret

# CORS: allowed frontend origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:3000

# Hardware mode: "simulation" emits synthetic telemetry (no MQTT/ESP32 needed);
# "live" expects a real MQTT broker + devices.
HARDWARE_MODE=simulation

# MQTT broker (used only when HARDWARE_MODE=live)
MQTT_HOST=localhost
MQTT_PORT=1883

# ESP32 device API key for HTTP telemetry ingestion
# Generate a secure random string for production
DEVICE_API_KEY=REPLACE_WITH_DEVICE_API_KEY

# Relay ACK timeout (seconds) before a command is marked TIMEOUT
RELAY_ACK_TIMEOUT=10

# Public base URL of this backend — used to build Exotel voice/callback URLs.
BASE_URL=http://localhost:8000

# Exotel telephony (leave blank to run SMS/voice in dry-run)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_CALLER_ID=

# ---------------------------------------------------------------------------
# Fault Simulator (/Simulator) — software-only test harness.
# Location/topology configuration:
# ---------------------------------------------------------------------------
SIMULATOR_DEVICE_ID=SIM_NODE_01
SIMULATOR_POLE_LABEL=POLE-A -> POLE-B (SIM span)
SIMULATOR_LATITUDE=9.9670
SIMULATOR_LONGITUDE=76.3010
SIMULATOR_PINCODE=682019
SIMULATOR_AREA=Tripunithura, Ernakulam
SIMULATOR_OPERATOR_ID=OP-01
SIMULATOR_OPERATOR_NAME=Demo Operator

# Feeder ports on the simulated node. The primary port carries load until a
# fault; the signal is then rerouted to the backup port.
SIMULATOR_PORT_PRIMARY=PORT-1
SIMULATOR_PORT_BACKUP=PORT-2

# Contact numbers — REQUIRED for live dispatch, intentionally blank by default
# so that no number is ever hardcoded in application code.
SIMULATOR_OPERATOR_PHONE=
SIMULATOR_AFFECTED_USER_PHONES=

# Emergency service used for escalation (shape matches the planned
# emergency_services table: service_type / name / phone).
EMERGENCY_SERVICE_TYPE=police
EMERGENCY_SERVICE_NAME=
EMERGENCY_SERVICE_PHONE=

# Landmark spoken/sent with the alert, e.g. "the Chemberi junction". Optional.
SIMULATOR_LANDMARK=

# After the operator's fault call, a second call to the SAME operator number
# reports that the police station was informed. The delay lets the first call
# finish — Exotel cannot connect a second leg while the line is busy.
POLICE_FOLLOWUP_CALL_ENABLED=true
POLICE_FOLLOWUP_DELAY_S=45
